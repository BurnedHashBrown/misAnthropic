# Filtr. AI Backend Environment Configuration
# Add at least one API key below for AI-powered safety analysis.
# If no key is set, the system uses browser OCR + local pattern matching.

# Option 1: Anthropic Claude (Vision + Text)
ANTHROPIC_API_KEY=

# Option 2: Google Gemini (Multimodal Vision + Text - free tier available at https://aistudio.google.com/)
GEMINI_API_KEY=

# Server Port (default 8000)
PORT=8000
