{
  "manifest_version": 3,
  "name": "Filtr. Live Watch",
  "version": "1.0.0",
  "description": "A private early-warning companion for online conversations. Watches for pressure, secrecy, and financial requests — all on your device.",
  "permissions": [
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*"
  ],
  "action": {},
  "incognito": "spanning",
  "side_panel": {
    "default_path": "side-panel/panel.html"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["platform-config.js", "content-scripts/extractor.js", "content-scripts/observer.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["side-panel/*", "icons/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
