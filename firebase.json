{
  "hosting": [
    {
      "site": "filtr-safe",
      "public": ".",
      "ignore": [
        "firebase.json",
        ".firebaserc",
        "**/.*",
        "**/node_modules/**",
        "backend/**",
        "*.md",
        "decisions/**",
        "filtr-extension/**"
      ],
      "headers": [
        {
          "source": "**/*.@(js|html|css|zip|png)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            }
          ]
        }
      ]
    },
